# ── App ──────────────────────────────────────────────
APP_URL=https://your-app.vercel.app           # used in Telegram links and on /setup
DASHBOARD_PASSWORD=                           # password for the dashboard (callers' data is behind it)
VAANI_WEBHOOK_SECRET=                         # any long random string; also set in Vaani

# ── Gemini (structuring + handoff note) ──────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_INPUT_USD_PER_M=0.30
GEMINI_OUTPUT_USD_PER_M=2.50
USD_TO_INR=88

# ── Vaani (voice) ────────────────────────────────────
VAANI_COST_PER_MIN_INR=6                      # your Vaani per-minute rate, for the cost tiles

# ── Supabase (call log) ──────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Telegram (designer handoff + escalations) ────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_DESIGNER_CHAT_ID=
TELEGRAM_ESCALATION_CHAT_ID=                  # optional; falls back to the designer chat

# ── HubSpot (new qualified calls only) ───────────────
HUBSPOT_PRIVATE_APP_TOKEN=
HUBSPOT_PIPELINE_ID=default
HUBSPOT_DEALSTAGE_CONSULTATION_BOOKED=appointmentscheduled

# ── Cal.com (booking during the call) ────────────────
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_ATTENDEE_EMAIL=                        # studio inbox that receives booking emails

# ── Studio hours ─────────────────────────────────────
STUDIO_TIMEZONE=Asia/Kolkata
OFFICE_OPEN_HOUR=10
OFFICE_CLOSE_HOUR=19

# ── Open decisions to confirm with Nikhil (rubric §12) ──
ASSISTANT_NAME=Aangan Studio's automated assistant
ESCALATION_CALLBACK_PROMISE=a senior person will call you back shortly
COMMERCIAL_MIN_SQFT=0                         # 0 = no hard minimum (services.md); 500 per T18
FORWARD_UNCLEAR_AFTER_ONE_QUESTION=true
AGENT_LANGUAGES=English
